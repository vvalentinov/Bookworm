@using Microsoft.AspNetCore.Http.Features

@{
    var consentFeature = this.Context.Features.Get<ITrackingConsentFeature>();
    var showBanner = !consentFeature?.CanTrack ?? false;
    var cookieString = consentFeature?.CreateConsentCookie();
}

@if (showBanner)
{
    <div id="cookieConsent"
         class="alert alert-dismissible text-white fade show mx-5 fs-4 rounded-4 d-flex justify-content-center align-items-center" role="alert">
        <span>We use cookies to understand how you use our site and to improve your experience.</span>
        <button type="button"
                class="btn accept-policy close fs-4 mx-3 px-4"
                data-dismiss="alert"
                aria-label="Close"
                data-cookie-string="@cookieString">
            <span aria-hidden="true">Accept</span>
        </button>
        <button type="button"
                class="btn-close border border-3"
                data-bs-dismiss="alert"
                aria-label="Close">
        </button>
    </div>
}
